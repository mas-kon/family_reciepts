# Example settings. Copy to .env and fill in: cp .env.example .env
# Русская версия: .env.example.ru

# ===== Telegram =====
# Token from @BotFather. Turn off the bot's privacy mode: /setprivacy -> Disable
BOT_TOKEN=
# Family group ID (add the bot to the group and send /chatid). Several are comma-separated.
ALLOWED_CHAT_IDS=
# Where to post the monthly report and budget warnings. Defaults to the first group in the list.
# REPORT_CHAT_ID=

# ===== LLM (any OpenAI-compatible API) =====
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Models in order: if the first one does not answer, the next one is tried.
# Receipt photos (the models must understand images).
# Gemini 3.x goes through your Google AI Studio key if it is connected in OpenRouter (BYOK); 2.5 is
# no longer available to new AI Studio users and is paid from the OpenRouter balance.
LLM_MODELS=google/gemini-3.5-flash-lite,google/gemini-3.5-flash,deepseek/deepseek-v4.1-flash
# Cascade: a receipt whose totals do not match is re-read with these models. Empty = off.
LLM_STRONG_MODELS=google/gemini-3.5-flash,deepseek/deepseek-v4.1-flash
# Text tasks: text expenses, bank notifications and statements, report comment,
# product merging, electronic receipts. Empty = LLM_MODELS.
LLM_TEXT_MODELS=google/gemini-3.5-flash-lite,deepseek/deepseek-v4.1-flash
# Voice messages (the models must understand audio, e.g. Gemini). Empty = off.
LLM_AUDIO_MODELS=google/gemini-3.5-flash-lite,google/gemini-3.5-flash
# Questions in the web app (tool calling required). Empty = LLM_TEXT_MODELS.
# LLM_ASK_MODELS=

# Balance (Settings → LLM). The bot warns the group when the OpenRouter account or the key's limit
# has less than this left, USD. 0 = no warning.
# LLM_BALANCE_ALERT=1
# DeepSeek key, only to show its balance. Requests still go through LLM_BASE_URL.
# DEEPSEEK_API_KEY=

# Other providers, examples:
# Google Gemini directly (has a free tier):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODELS=gemini-3.5-flash-lite
# Local Ollama:
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODELS=qwen2.5vl:7b

# ===== Web app =====
WEB_HOST=0.0.0.0
WEB_PORT=8000
# Public address of the web app, for the bot's "Open" button
WEB_BASE_URL=
# Random string for signing cookies: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
# Fallback password sign-in when there is no domain for Telegram Login. Empty = off.
WEB_PASSWORD=
# Turn sign-in off completely. Local development only!
# AUTH_DISABLED=true

# ===== Receipts by e-mail (IMAP) =====
# A separate mailbox that electronic receipts are forwarded to. Empty = off.
# Gmail needs an "app password"; the regular password will not work.
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=checks.family@gmail.com
# IMAP_PASSWORD=
# IMAP_FOLDER=INBOX
# IMAP_POLL_MINUTES=10

# ===== Warranties =====
# How many days before a warranty ends to remind the group
# WARRANTY_REMIND_DAYS=30

# ===== Other =====
# DATABASE_URL=sqlite+aiosqlite:////root/check_bot/data/app.db
TIMEZONE=Europe/Sofia
